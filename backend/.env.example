# ================================================================
# SoftCraft Solutions — Backend Environment Variables
# Copy this file to .env and fill in your values
# ================================================================

# ── Django core ──────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-generate-50-char-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────
# Development: leave blank to use SQLite (no setup needed)
# Production:  DATABASE_URL=postgresql://user:pass@localhost:5432/softcraft
DATABASE_URL=

# ── Razorpay (required for checkout) ─────────────────────────────
# Get free test keys from: https://razorpay.com → Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ── Email ────────────────────────────────────────────────────────
# Development: leave as console backend (emails print to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production Gmail example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password

DEFAULT_FROM_EMAIL=SoftCraft Solutions <noreply@softcraft.in>

# ── Site URLs ────────────────────────────────────────────────────
SITE_URL=http://localhost:3000
SUPPORT_EMAIL=support@softcraft.in

# ── Redis (optional — only needed in production) ─────────────────
# Leave blank for local dev (uses in-memory cache automatically)
REDIS_URL=

# ── CORS ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
